# Copie este arquivo para .env e preencha com os valores do SEU ambiente.
# Todas as variáveis EXPO_PUBLIC_* são embutidas no bundle do app pelo Expo.
# Veja SETUP.md para o passo a passo de onde obter cada valor.

# ── Firebase (console.firebase.google.com → Configurações do projeto → Seus apps) ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Microsoft Entra ID (portal.azure.com → App registrations) ──
# "Application (client) ID" do app registrado
EXPO_PUBLIC_AZURE_CLIENT_ID=
# Tenant ID (GUID) da organização Inatel no Microsoft 365
EXPO_PUBLIC_AZURE_TENANT_ID=
# ID do provedor OIDC criado no Firebase Authentication (padrão: oidc.microsoft)
EXPO_PUBLIC_FIREBASE_OIDC_PROVIDER_ID=oidc.microsoft
